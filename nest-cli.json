{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "modules/mails/templates/**/*", "watchAssets": true },
      { "include": "assets/**/*", "watchAssets": true, "outDir": "dist" }
    ]
  }
}
